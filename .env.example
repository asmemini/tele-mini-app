# Existing Magster Supabase project (do not create a new one).
# Server-only. Never expose a service-role key to the browser.
SUPABASE_URL=https://mrzmhtirmxqnnoqppnyf.supabase.co
SUPABASE_ANON_KEY=

# Used to HMAC-sign the Mini App session cookie after Telegram initData is verified.
SESSION_SECRET=

# Telegram Bot token bound to this Mini App. Server-only.
# Required to treat a Telegram user as authenticated.
TELEGRAM_BOT_TOKEN=

# Optional. Seconds after auth_date after which initData is rejected. Default: 86400.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
